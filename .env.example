# ========================
# Server
# ========================
# WSL2 コンテナ内で動かすため 0.0.0.0 バインドが必須
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# 同時生成は 1 に固定（16GB VRAM）
GPU_CONCURRENCY=1

# ========================
# Storage
# ========================
# HuggingFace モデルキャッシュ
HF_HOME=./data/models
# Civitai 等の単体ウェイト配置先
WEIGHTS_DIR=./data/weights
# 生成画像の保存先
IMAGES_DIR=./data/images
# Danbooru タグ検索の索引元 CSV(danbooru.csv)を置く場所
TAGS_DIR=./data/tags

# ========================
# Models — LLM
# ========================
# LLM は llama.cpp(GGUF) で動かす。形式: "<hf_repo>:<filename.gguf>" か ローカル .gguf パス。
# 既定は無検閲(heretic) Gemma 4 12B（日本語・会話品質と速度・VRAM のバランス）。
LLM_MODEL_ID=igorls/gemma-4-12B-it-heretic-GGUF:gemma-4-12B-it-heretic-Q4_K_M.gguf

# --- 差し替え例 ---
# 検閲版(aligned)を使うなら公式 QAT 12B に差し替える:
# LLM_MODEL_ID=google/gemma-4-12B-it-qat-q4_0-gguf:gemma-4-12b-it-qat-q4_0.gguf
# さらに軽量を優先するなら公式 QAT E4B:
# LLM_MODEL_ID=google/gemma-4-E4B-it-qat-q4_0-gguf:gemma-4-E4B_q4_0-it.gguf

# LLM サンプリング。会話品質のため temperature>0 を既定にする（temperature=0 は長いタグ列で
# 破滅的なリピートループを誘発することを実機確認済み。repeat_penalty も併用）。
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_TOP_K=40
LLM_REPEAT_PENALTY=1.1

# コンテキスト長と KV キャッシュ。既定は fp16 KV + iSWA コンパクトキャッシュ
# (LLM_SWA_FULL=false) で 32768（16GB でプロセス約 8.8GB 実測）。
# q8_0 は VRAM 半減だが多ターン(~16k)で指示追従・ツール呼び出しの劣化を実測したため
# 既定から外した（docs/decisions/0003-kv-cache-fp16-iswa.md）。量子化 KV を使うなら
# K/V 同型 + FLASH_ATTN=true が必須。
LLM_N_CTX=32768
LLM_KV_CACHE_TYPE=f16
LLM_FLASH_ATTN=true
# SWA 層の KV を n_ctx 全長で確保するか。false はウィンドウ長に切り詰める（品質同一・
# KV 激減・decode 高速）。true の利点は深い履歴分岐のキャッシュ再利用のみ。
LLM_SWA_FULL=false
# ターン開始時にユーザ発話をタグ辞書と逆引き照合し、正規タグ候補を自動注入する事前検索。
# 知ったかぶり(非正規タグでの生成)・深い文脈での検索規律低下への構造対策
# （docs/decisions/0005-tag-hints-presearch.md）。
LLM_TAG_HINTS=true

# ========================
# Tag search (Danbooru) — search_tags ツール
# ========================
# 正規 Danbooru タグ/キャラ表記の語彙検索。索引元 CSV は ${TAGS_DIR}/danbooru.csv を読む。
# CSV 未配置時に自動ダウンロードするか。既定は OFF（WSL2 オフライン運用・事前配置前提）。
# 未配置なら索引は空のまま起動し search は空を返す（起動ログに warning が出る）。
TAGS_AUTO_DOWNLOAD=false
# TAGS_AUTO_DOWNLOAD=true のときの取得元（hdae/danbooru-tagcomplete-extra prebuilt CSV）。
TAGS_CSV_URL=https://github.com/hdae/danbooru-tagcomplete-extra/releases/download/2026-05-23/danbooru.csv

# ========================
# Models — Image
# ========================
# Anima のベース(diffusers 形式リポ)。VAE / Qwen3 text encoder / tokenizer / scheduler /
# modular pipeline 定義をここから読む。派生は DiT だけを差し替えるためベースは常に共有する。
IMAGE_BASE_MODEL_ID=circlestone-labs/Anima-Base-v1.0-Diffusers

# 派生モデル(DiT 単体チェックポイント)。次のいずれかを指定できる:
#   - Civitai の AIR(URN)  例: urn:air:anima:checkpoint:civitai:<modelId>@<versionId>
#                          → ${WEIGHTS_DIR}/civitai/{slug}-{sha256[:12]}.{ext} に自動配置
#   - 明示ローカルパス      例: ./data/weights/civitai/waianima-v10base10-<sha12>.safetensors
#   - 空                    → 派生なし(ベースだけ)を使う
# デフォルトは wai-anima の AIR。diffusers 形式リポは IMAGE_MODEL_ID ではなく上の
# IMAGE_BASE_MODEL_ID に指定すること。
IMAGE_MODEL_ID=urn:air:anima:checkpoint:civitai:2544636@2983680

# Civitai の gated モデルを使うときのみ設定。
# CIVITAI_TOKEN=

# --- 高速化: Turbo LoRA（step & CFG 蒸留）---
# 設定すると DiT へ PEFT アダプタとして注入し、生成時の steps / CFG を下の IMAGE_TURBO_*
# に切り替えて高速生成する。空文字にすると無効化され base 品質（DEFAULT_STEPS / DEFAULT_CFG）
# で動く。形式は IMAGE_MODEL_ID と同じ: Civitai AIR(URN) / HF リポ / ローカル .safetensors。
# 既定は高速化を体感できるよう Anima Turbo LoRA を ON。
IMAGE_TURBO_LORA=urn:air:anima:lora:civitai:2560840@2979642
# 適用強度。1.0 が既定。0.7 程度まで下げると多様性が増す（蒸留効果は維持）。
IMAGE_TURBO_LORA_STRENGTH=1.0
# Turbo 有効時の生成パラメータ。この LoRA は CFG≈1 / 8〜12 steps を推奨する。
IMAGE_TURBO_STEPS=10
IMAGE_TURBO_CFG=1.0

# ========================
# VRAM 運用モード
# ========================
# auto       : 起動時に VRAM を見て coresident / swap を自動選択（既定）
# swap       : ターンごとに LLM ↔ Image を入れ替え（16GB 以下向け）
# coresident : 両モデルを GPU 常駐（24GB+ 向け）
RESIDENCY_MODE=auto
# coresident に切り替える VRAM 下限（GiB）
RESIDENCY_CORESIDENT_THRESHOLD_GB=20.0

# 起動時に fetch_models + モデルプリロードを実行する。
# テストから lifespan を乗っ取るときだけ false。
STARTUP_PRELOAD=true

# ========================
# Generation defaults
# ========================
# steps / CFG は Turbo 無効時（base 品質）にのみ使う。Turbo 有効時は上の IMAGE_TURBO_* が優先。
DEFAULT_WIDTH=896
DEFAULT_HEIGHT=1152
DEFAULT_STEPS=32
DEFAULT_CFG=4.0
